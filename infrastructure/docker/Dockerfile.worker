FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/packages/shared/src:/app/packages/parser/src:/app/packages/graph-engine/src:/app/packages/embeddings/src:/app/packages/retrieval/src:/app/packages/prompts/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential nodejs npm \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g tree-sitter-cli

FROM base AS development

COPY packages/shared/ /app/packages/shared/
RUN pip install -e /app/packages/shared

COPY apps/workers/ /app/apps/workers/
COPY packages/ /app/packages/

WORKDIR /app/packages/parser
RUN python setup_grammars.py

WORKDIR /app/apps/workers
RUN pip install --no-cache-dir -e ".[dev]"

CMD ["celery", "-A", "app.main", "worker", "--loglevel=info", "--concurrency=4"]

FROM base AS production

COPY packages/shared/ /app/packages/shared/
RUN pip install -e /app/packages/shared

COPY apps/workers/ /app/apps/workers/
COPY packages/ /app/packages/

WORKDIR /app/packages/parser
RUN python setup_grammars.py

WORKDIR /app/apps/workers
RUN pip install --no-cache-dir -e .

CMD ["celery", "-A", "app.main", "worker", "--loglevel=info", "--concurrency=4"]
