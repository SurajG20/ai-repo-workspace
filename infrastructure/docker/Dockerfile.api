FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/packages/shared/src:/app/packages/parser/src:/app/packages/graph-engine/src:/app/packages/embeddings/src:/app/packages/retrieval/src:/app/packages/prompts/src

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git build-essential nodejs npm \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g tree-sitter-cli

FROM base AS development

COPY packages/shared/ /app/packages/shared/
RUN pip install -e /app/packages/shared

COPY apps/api/ /app/apps/api/
COPY packages/ /app/packages/

WORKDIR /app/packages/parser
RUN python setup_grammars.py

WORKDIR /app/apps/api
RUN pip install -e .

COPY infrastructure/scripts/api-entrypoint.sh /app/api-entrypoint.sh
RUN chmod +x /app/api-entrypoint.sh

EXPOSE 8000

CMD ["sh", "/app/api-entrypoint.sh", "--reload"]

FROM base AS production

COPY packages/shared/ /app/packages/shared/
RUN pip install -e /app/packages/shared

COPY apps/api/ /app/apps/api/
COPY packages/ /app/packages/

WORKDIR /app/packages/parser
RUN python setup_grammars.py

WORKDIR /app/apps/api
RUN pip install --no-cache-dir -e .

COPY infrastructure/scripts/api-entrypoint.sh /app/api-entrypoint.sh
RUN chmod +x /app/api-entrypoint.sh

EXPOSE 8000

CMD ["sh", "/app/api-entrypoint.sh"]
